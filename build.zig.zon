.{
    .name = .graphviz,
    .version = "0.1.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x5480083b83df9168,

    // No `upstream` dependency yet, deliberately.
    //
    // The graphviz release tarball is the only source shipping the
    // pre-generated bison/flex/python outputs this build consumes, but zig's
    // package fetcher rejects it:
    //
    //   error: unable to unpack tarball
    //       note: file 'redhat/graphviz.spec.rhel.in' has unsupported type '1'
    //
    // std.tar refuses hard links, and `make dist` emitted one for a duplicated
    // RPM spec template. There is therefore no valid hash to pin. Until that is
    // resolved, build with -Dupstream-path=<extracted release tree>.
    //
    // To pin it once resolved:
    //   zig fetch --save=upstream <tarball-url>
    // then set `has_pinned_upstream = true` in build.zig.
    .dependencies = .{
        .translate_c = .{
            .url = "git+https://codeberg.org/ziglang/translate-c?ref=refs/tags/2.0.0#0da7a16c3235b935b82421646076e0657cda21f6",
            .hash = "translate_c-2.0.0-Q_BUWltOBwA0229IE8wwSxxGzOxyRso3hvcb1nN8oJX_",
        },
    },

    .paths = .{
        "LICENSE",
        "README.md",
        "build.zig",
        "build.zig.zon",
        "examples",
        "src",
    },
}
